{
  "version": 2,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30
    },
    "api/worker.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/keepalive",
      "schedule": "0 20 * * *"
    }
  ]
}
